# Copy to .env.local and fill in. .env.local is gitignored; this file is not,
# so never put a real value here.

# ---------------------------------------------------------------- required
# Postgres. Neon is what this is built against; any Postgres 15+ works.
DATABASE_URL=

# ---------------------------------------------------------------- uploads
# Vercel Blob store token. Without it image upload fails and the rest of the
# shop works. One PRIVATE store: catalogue art is marked PUBLIC in the
# uploads table and served through /api/media/[id]; customer photos stay
# PRIVATE and go through /api/uploads/[id], which checks ownership.
BLOB_READ_WRITE_TOKEN=

# ---------------------------------------------------------------- payments
# Leave both empty to run without a gateway. The checkout then disables the
# online methods instead of offering them and failing; cash on delivery still
# works, so the whole order flow can be exercised.
# KEY_SECRET verifies the payment signature and must never reach the browser.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---------------------------------------------------------------- metadata
# Canonical origin for OG tags and canonical links, e.g. https://shivradium.in
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------- seed
# Only read by `pnpm db:seed`. If SEED_ADMIN_PASSWORD is empty the seed
# generates one and prints it once when it finishes.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_DEMO_PASSWORD=
