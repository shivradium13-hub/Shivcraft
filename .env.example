# Copy to .env.local and fill in. .env.local is gitignored; this file is not,
# so never put a real value here.

# ---------------------------------------------------------------- required
# Postgres. Neon is what this is built against; any Postgres 15+ works.
DATABASE_URL=

# ---------------------------------------------------------------- uploads
# Vercel Blob store token. Without it image upload fails and the rest of the
# shop works. One PRIVATE store: catalogue art is marked PUBLIC in the
# uploads table and served through /api/media/[id]; customer photos stay
# PRIVATE and go through /api/uploads/[id], which checks ownership.
BLOB_READ_WRITE_TOKEN=

# ---------------------------------------------------------------- payments
# Leave both empty to run without a gateway. The checkout then disables the
# online methods instead of offering them and failing; cash on delivery still
# works, so the whole order flow can be exercised.
# KEY_SECRET verifies the payment signature and must never reach the browser.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ------------------------------------------------------------------ delivery
# Delhivery (courier). Leave empty to run without it: the PIN-code check falls
# back to a postal-zone estimate and orders are shipped manually. Get the token
# from Delhivery One -> Settings -> API Setup -> "Request Live API Token".
# PICKUP_NAME must match a pickup location registered in Delhivery One exactly.
# Set BASE_URL to the staging host while testing, then the live host.
DELHIVERY_API_TOKEN=
DELHIVERY_CLIENT_NAME=
DELHIVERY_PICKUP_NAME=
# https://staging-express.delhivery.com (test) or https://track.delhivery.com (live)
DELHIVERY_BASE_URL=
# A secret of your choice. Register the webhook URL in Delhivery One as
# /api/webhooks/delhivery?token=<this value> so the order updates itself on each
# scan. Empty = webhook disabled.
DELHIVERY_WEBHOOK_SECRET=

# -------------------------------------------------------------- notifications
# Order updates also go out by email and WhatsApp when these are set. Empty =
# that channel is off (in-app notifications always work). No fake messages.
# Email via Resend (resend.com): an API key and a verified From address.
RESEND_API_KEY=
EMAIL_FROM=
# WhatsApp via Meta's Cloud API: access token + the sender phone-number id.
# Business-initiated messages need APPROVED templates — put each approved
# template name in the matching var (leave blank to skip that event).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_TEMPLATE_CONFIRMED=
WHATSAPP_TEMPLATE_SHIPPED=
WHATSAPP_TEMPLATE_OUT_FOR_DELIVERY=
WHATSAPP_TEMPLATE_DELIVERED=
WHATSAPP_TEMPLATE_CANCELLED=
WHATSAPP_TEMPLATE_NDR=

# ---------------------------------------------------------------- metadata
# Canonical origin for OG tags and canonical links, e.g. https://shivradium.in
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------- seed
# Only read by `pnpm db:seed`. If SEED_ADMIN_PASSWORD is empty the seed
# generates one and prints it once when it finishes.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_DEMO_PASSWORD=
